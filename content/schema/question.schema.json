          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "basic",
            "intermediate",
            "advanced"
          ]
        },
        "prompt": {
